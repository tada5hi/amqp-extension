{
    "name": "amqp-extension",
    "version": "4.0.0",
    "type": "module",
    "description": "An amqp extension with functions and utility functions to consume and publish queue messages.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Tada5hi/amqp-extension.git"
    },
    "bugs": {
        "url": "https://github.com/Tada5hi/amqp-extension/issues"
    },
    "homepage": "https://github.com/Tada5hi/amqp-extension#readme",
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build": "tsdown",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage",
        "lint": "eslint",
        "lint:fix": "npm run lint -- --fix",
        "prepare": "husky"
    },
    "keywords": [
        "amqp",
        "amqplib",
        "rabbitmq",
        "consume",
        "publish",
        "typescript"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "MIT",
    "dependencies": {
        "amqp-connection-manager": "^5.0.0",
        "amqplib": "^2.2.0",
        "smob": "^1.6.2"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@tada5hi/commitlint-config": "^1.3.2",
        "@tada5hi/eslint-config": "^2.4.0",
        "@tada5hi/tsconfig": "^0.7.2",
        "@types/node": "^22.20.5",
        "@vitest/coverage-v8": "^5.0.4",
        "eslint": "^10.12.0",
        "husky": "^9.1.7",
        "testcontainers": "^12.2.1",
        "tsdown": "^0.23.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "vitest": "^5.0.4"
    }
}
